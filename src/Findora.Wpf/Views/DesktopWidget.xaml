<Window x:Class="Findora.Wpf.Views.DesktopWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Findora Widget"
        Height="54" Width="54"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ToolTip="Findora - Click to search (Ctrl+Alt+F)"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseRightButtonUp="Window_MouseRightButtonUp">
    <Grid Width="54" Height="54">
        <!-- Physical Liquid Glass Droplet Lens -->
        <Border x:Name="DiscBorder" Width="44" Height="44" CornerRadius="22"
                Background="{DynamicResource LiquidGlassTransmissionBrush}"
                BorderBrush="{DynamicResource LiquidGlassBevelBrush}" BorderThickness="1.2"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="DiscScale" ScaleX="1.0" ScaleY="1.0" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="14" ShadowDepth="3" />
            </Border.Effect>

            <!-- Internal Sub-Surface Thickness (Concentric Lens) -->
            <Border CornerRadius="20.5" BorderThickness="1" Margin="1"
                    BorderBrush="{DynamicResource LiquidGlassInnerBevelBrush}">
                <Grid>
                    <!-- Interactive Specular Sheen (Curved dome light) -->
                    <Border x:Name="WidgetSpecularOverlay" CornerRadius="20" IsHitTestVisible="False" Opacity="0.8" />

                    <!-- Top Specular Crescent Catch -->
                    <Border Width="24" Height="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,2,0,0"
                            Background="{DynamicResource TopReflectionBrush}" Opacity="0.85" />

                    <!-- Bottom Caustic Rebound Glint -->
                    <Border Width="18" Height="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2"
                            Background="{DynamicResource BottomCausticBrush}" Opacity="0.75" />

                    <!-- Vector Magnifying Glass Icon -->
                    <Canvas Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Canvas.Left="2" Canvas.Top="2" Width="10" Height="10"
                                 Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.0" />
                        <Line X1="9.5" Y1="9.5" X2="15" Y2="15"
                              Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
