<Window x:Class="Findora.Wpf.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Findora"
        Width="480" Height="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Border CornerRadius="16" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1.2" Margin="14"
            Background="{DynamicResource WindowGlassBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.45" />
        </Border.Effect>
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top-Edge Light Reflection -->
            <Border Grid.Row="0" Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="16,-21,16,0"
                    Background="{DynamicResource TopReflectionBrush}" IsHitTestVisible="False" />

            <!-- Header with Glowing Emblem & Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource SecondarySurfaceBrush}"
                        BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1.2" Margin="0,0,14,0">
                    <Canvas Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Canvas.Left="2" Canvas.Top="2" Width="10" Height="10" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.0" />
                        <Line X1="9.5" Y1="9.5" X2="15" Y2="15" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Findora" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Version 1.0 — Windows Desktop Edition" FontFamily="Segoe UI" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Info Content -->
            <Border Grid.Row="1" Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderGlassEdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Instant whole-computer filename search for Windows." FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="• In-memory high-fanout B+ Tree index with sub-millisecond retrieval" FontFamily="Segoe UI" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2" />
                    <TextBlock Text="• Persistent SQLite WAL file catalog &amp; reconciliation engine" FontFamily="Segoe UI" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2" />
                    <TextBlock Text="• Kernel-level ReadDirectoryChangesW live filesystem monitoring" FontFamily="Segoe UI" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2" />
                    <TextBlock Text="• Global Hotkey: Ctrl + Alt + F" FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Close Button -->
            <Button Grid.Row="2" Content="Close" Click="CloseButton_Click" HorizontalAlignment="Right"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="22,6"
                    FontFamily="Segoe UI" FontWeight="SemiBold" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
