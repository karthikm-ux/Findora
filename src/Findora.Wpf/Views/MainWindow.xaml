<Window x:Class="Findora.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Findora.Wpf.Models"
        Title="Findora Search"
        Width="920" Height="490"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- Custom ListBoxItem Style: Sub-Surface Liquid Glass Lens with Left Pill Accent -->
        <Style TargetType="ListBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,2,6,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" CornerRadius="9" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="12,8,14,8">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#1238BDF8" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected" />
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#2438BDF8" Duration="0:0:0.08" />
                                            <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#4238BDF8" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="SelectedIndicator"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1.0" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="ReturnSymbol"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1.0" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /> <!-- Left Accent Pill -->
                                    <ColumnDefinition Width="Auto" /> <!-- File Icon -->
                                    <ColumnDefinition Width="*" />    <!-- Name & Full Path -->
                                    <ColumnDefinition Width="Auto" /> <!-- Type & Size -->
                                    <ColumnDefinition Width="Auto" /> <!-- Return Key Badge -->
                                </Grid.ColumnDefinitions>

                                <!-- Left Accent Indicator Line (Selected state) -->
                                <Border x:Name="SelectedIndicator" Grid.Column="0" Width="3" Height="20" CornerRadius="1.5"
                                        Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="-6,0,8,0" Opacity="0" />

                                <!-- File Icon -->
                                <Image Grid.Column="1" Source="{Binding Icon}" Width="26" Height="26" Margin="0,0,14,0"
                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                                <!-- Filename and Full Directory Path -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Filename}" FontFamily="Segoe UI" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DisplayPath}" FontFamily="Segoe UI" FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- File Type & Formatted Size -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding FileTypeDescription}" FontFamily="Segoe UI" FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding FormattedSize}" FontFamily="Segoe UI" FontSize="10.5"
                                               Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Return Key Action Badge (↵) -->
                                <TextBlock x:Name="ReturnSymbol" Grid.Column="4" Text="↵" FontFamily="Segoe UI" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Opacity="0" Margin="4,0,2,0" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ================================================================= -->
    <!-- LIQUID GLASS CONTAINER - Multi-Layered Physical Optical Pipeline  -->
    <!-- ================================================================= -->
    <Border x:Name="MainCard" Margin="14" CornerRadius="18" RenderTransformOrigin="0.5,0.2">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0" />
                <TranslateTransform x:Name="CardTranslate" Y="0" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <!-- Physical Contact & Atmospheric Shadow -->
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="7" Opacity="0.42" />
        </Border.Effect>

        <!-- LAYER 1: Outer Refractive Caustic Bevel Rim -->
        <Border x:Name="OuterCausticBevel" CornerRadius="18"
                BorderThickness="1.2" BorderBrush="{DynamicResource LiquidGlassBevelBrush}"
                Background="{DynamicResource LiquidGlassTransmissionBrush}">

            <!-- LAYER 2: Internal Sub-Surface Thickness Bevel (Simulates 4mm physical glass volume) -->
            <Border x:Name="InternalRefractionLayer" CornerRadius="17" BorderThickness="1"
                    BorderBrush="{DynamicResource LiquidGlassInnerBevelBrush}"
                    Background="Transparent">

                <Grid>
                    <!-- LAYER 3: Dynamic Pointer Specular Sheen (Real-time cursor-following light glint) -->
                    <Border x:Name="InteractiveSpecularOverlay" CornerRadius="17" IsHitTestVisible="False" Opacity="0.85" />

                    <!-- LAYER 4: Top-Edge Specular Fresnel Catch (1.2px physical reflection) -->
                    <Border x:Name="TopFresnelCatch" Height="1.2" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Margin="18,1,18,0" Background="{DynamicResource TopReflectionBrush}"
                            IsHitTestVisible="False" Panel.ZIndex="10" />

                    <!-- LAYER 5: Bottom Caustic Rebound Glint (Light focusing through bottom curve) -->
                    <Border x:Name="BottomCausticGlint" Height="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            Margin="24,0,24,1" Background="{DynamicResource BottomCausticBrush}"
                            IsHitTestVisible="False" Panel.ZIndex="10" />

                    <!-- LAYER 6: Content Grid -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54" /> <!-- Search Bar Header -->
                            <RowDefinition Height="1" />  <!-- Top Separator Hairline -->
                            <RowDefinition Height="*" />  <!-- Main Results Area -->
                            <RowDefinition Height="1" />  <!-- Bottom Separator Hairline -->
                            <RowDefinition Height="34" /> <!-- Slim Glass Footer -->
                        </Grid.RowDefinitions>

                        <!-- ROW 0: Search Bar Header -->
                        <Grid Grid.Row="0" Margin="16,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /> <!-- Liquid Lens Icon -->
                                <ColumnDefinition Width="*" />    <!-- Search Input & Placeholder -->
                                <ColumnDefinition Width="Auto" /> <!-- Clear Button -->
                                <ColumnDefinition Width="Auto" /> <!-- Results & Timing Summary Pill -->
                                <ColumnDefinition Width="Auto" /> <!-- Global Shortcut Capsule -->
                                <ColumnDefinition Width="Auto" /> <!-- Settings Gear Button -->
                            </Grid.ColumnDefinitions>

                            <!-- Understated Vector Lens Icon -->
                            <Canvas Grid.Column="0" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="12" Height="12"
                                         Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.0" />
                                <Line X1="11.5" Y1="11.5" X2="17.5" Y2="17.5"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>

                            <!-- Search Input Field & Placeholder -->
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="PlaceholderTextBlock" Text="Search files, folders, apps..."
                                           FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0" />
                                <TextBox x:Name="SearchTextBox" FontFamily="Segoe UI" FontSize="15" FontWeight="Normal"
                                         Foreground="{DynamicResource PrimaryTextBrush}" CaretBrush="{DynamicResource AccentBrush}" Background="Transparent"
                                         BorderThickness="0" VerticalAlignment="Center"
                                         TextChanged="SearchTextBox_TextChanged" />
                            </Grid>

                            <!-- Clear Button (✕) -->
                            <Button x:Name="ClearButton" Grid.Column="2" Content="✕"
                                    FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"
                                    Background="Transparent" BorderThickness="0" Padding="6,4" Margin="0,0,8,0"
                                    Cursor="Hand" Visibility="Collapsed" Click="ClearButton_Click" />

                            <!-- Results & Prominent Timing Summary Pill (Sub-surface liquid capsule) -->
                            <Border Grid.Column="3" Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderGlassEdgeBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="ResultsHeaderTextBlock" Text="0 results"
                                               FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text=" · " FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock x:Name="ProminentSearchTimeText" Text="0.00 ms"
                                               FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PerfAccentBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Shortcut Capsule: "Ctrl + Alt + F" -->
                            <Border Grid.Column="4" Background="{DynamicResource KeycapBackgroundBrush}" BorderBrush="{DynamicResource KeycapBorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + Alt + F" FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KeycapTextBrush}" VerticalAlignment="Center" />
                            </Border>

                            <!-- Settings Gear Icon Button -->
                            <Button x:Name="SettingsButton" Grid.Column="5" Background="Transparent" BorderThickness="0"
                                    Padding="6" Cursor="Hand" Click="SettingsButton_Click" ToolTip="Settings &amp; Exclusions">
                                <Canvas Width="16" Height="16" VerticalAlignment="Center">
                                    <Ellipse Canvas.Left="3.5" Canvas.Top="3.5" Width="9" Height="9"
                                             Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.8" />
                                    <Ellipse Canvas.Left="6" Canvas.Top="6" Width="4" Height="4"
                                             Fill="{DynamicResource MutedTextBrush}" />
                                    <Line X1="8" Y1="1" X2="8" Y2="3" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" />
                                    <Line X1="8" Y1="13" X2="8" Y2="15" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" />
                                    <Line X1="1" Y1="8" X2="3" Y2="8" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" />
                                    <Line X1="13" Y1="8" X2="15" Y2="8" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" />
                                </Canvas>
                            </Button>
                        </Grid>

                        <!-- ROW 1: Sub-pixel Hairline Separator -->
                        <Rectangle Grid.Row="1" Fill="{DynamicResource SeparatorBrush}" HorizontalAlignment="Stretch" />

                        <!-- ROW 2: Main Full-Width Results Area -->
                        <Grid Grid.Row="2" Margin="6,6,6,6">
                            <!-- Results ListBox -->
                            <ListBox x:Name="ResultsListBox" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionMode="Single" Margin="0"
                                     MouseDoubleClick="ResultsListBox_MouseDoubleClick" />

                            <!-- Empty State Banner -->
                            <StackPanel x:Name="EmptyStatePanel" Margin="24,60" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="🔍" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.35" />
                                <TextBlock Text="No matching files found" FontFamily="Segoe UI" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Try a different query or adjust excluded directories in Settings."
                                           FontFamily="Segoe UI" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Loading State Banner -->
                            <StackPanel x:Name="LoadingStatePanel" Margin="24,60" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="Searching index..." FontFamily="Segoe UI" FontSize="13" FontStyle="Italic"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Feedback Toast Banner -->
                            <Border x:Name="FeedbackToast" Background="#803B1219" BorderBrush="#EF4444" BorderThickness="1.2"
                                    CornerRadius="8" Padding="12,6" Margin="12,0,12,8" Visibility="Collapsed"
                                    VerticalAlignment="Bottom">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚠️" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" />
                                    <TextBlock x:Name="FeedbackToastText" Grid.Column="1" Text="File error"
                                               FontFamily="Segoe UI" FontSize="11.5" Foreground="#FCA5A5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="CloseToastButton" Grid.Column="2" Content="✕"
                                            Background="Transparent" BorderThickness="0" Foreground="#FCA5A5"
                                            FontWeight="Bold" Padding="6,2" Cursor="Hand" Click="CloseToastButton_Click" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ROW 3: Sub-pixel Hairline Separator -->
                        <Rectangle Grid.Row="3" Fill="{DynamicResource SeparatorBrush}" HorizontalAlignment="Stretch" />

                        <!-- ROW 4: Slim Liquid Glass Footer -->
                        <Border Grid.Row="4" Background="{DynamicResource SecondarySurfaceBrush}" CornerRadius="0,0,16,16" Padding="14,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />    <!-- Microsecond Timing Breakdown -->
                                    <ColumnDefinition Width="Auto" /> <!-- Keyboard Shortcuts Hints -->
                                </Grid.ColumnDefinitions>

                                <!-- Left: Microsecond Search Performance -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="11" Foreground="{DynamicResource PerfAccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Total: " FontFamily="Segoe UI" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TotalSearchTimeText" Text="0.00 ms" FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="  ·  Index lookup: " FontFamily="Segoe UI" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="IndexSearchTimeText" Text="0.00 ms" FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Right: Keyboard Shortcut Badges -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{DynamicResource KeycapBadgeStyle}" Margin="0,0,4,0">
                                        <TextBlock Text="Enter" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource KeycapTextBrush}" />
                                    </Border>
                                    <TextBlock Text="Reveal" FontFamily="Segoe UI" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />

                                    <Border Style="{DynamicResource KeycapBadgeStyle}" Margin="0,0,4,0">
                                        <TextBlock Text="Shift+Enter" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource KeycapTextBrush}" />
                                    </Border>
                                    <TextBlock Text="Open" FontFamily="Segoe UI" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />

                                    <Border Style="{DynamicResource KeycapBadgeStyle}" Margin="0,0,4,0">
                                        <TextBlock Text="↑ ↓" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource KeycapTextBrush}" />
                                    </Border>
                                    <TextBlock Text="Navigate" FontFamily="Segoe UI" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />

                                    <Border Style="{DynamicResource KeycapBadgeStyle}" Margin="0,0,4,0">
                                        <TextBlock Text="Esc" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource KeycapTextBrush}" />
                                    </Border>
                                    <TextBlock Text="Dismiss" FontFamily="Segoe UI" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Border>
</Window>
