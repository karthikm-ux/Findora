<Window x:Class="Findora.Wpf.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Findora Settings"
        Width="550" Height="490"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Border CornerRadius="16" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1.2" Margin="14"
            Background="{DynamicResource WindowGlassBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.45" />
        </Border.Effect>
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top-Edge Light Reflection -->
            <Border Grid.Row="0" Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="16,-21,16,0"
                    Background="{DynamicResource TopReflectionBrush}" IsHitTestVisible="False" />

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="⚙️ Settings &amp; Preferences" FontFamily="Segoe UI" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="Appearance, autostart behavior, and indexed folder exclusions" FontFamily="Segoe UI" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
            </StackPanel>

            <!-- Options Box -->
            <Border Grid.Row="1" Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderGlassEdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                <StackPanel>
                    <!-- Theme Mode Selector -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                        <TextBlock Text="Theme:" FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <RadioButton x:Name="ThemeSystemRadio" Content="System (Default)" GroupName="ThemeGroup"
                                     Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Segoe UI" FontSize="12" Margin="0,0,14,0"
                                     Checked="ThemeRadio_Checked" />
                        <RadioButton x:Name="ThemeDarkRadio" Content="Dark" GroupName="ThemeGroup"
                                     Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Segoe UI" FontSize="12" Margin="0,0,14,0"
                                     Checked="ThemeRadio_Checked" />
                        <RadioButton x:Name="ThemeLightRadio" Content="Light" GroupName="ThemeGroup"
                                     Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Segoe UI" FontSize="12"
                                     Checked="ThemeRadio_Checked" />
                    </StackPanel>

                    <!-- Autostart CheckBox -->
                    <CheckBox x:Name="AutostartCheckBox" Content="Launch Findora automatically when signing into Windows"
                              FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"
                              Checked="AutostartCheckBox_Changed" Unchecked="AutostartCheckBox_Changed" />
                    
                    <!-- Rescan Button -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RescanButton" Content="🔄 Re-index All Local Drives" Click="RescanButton_Click"
                                Background="{DynamicResource SecondarySurfaceBrush}" Foreground="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource BorderGlassEdgeBrush}" BorderThickness="1" Padding="12,5"
                                FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <TextBlock x:Name="RescanStatusText" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Exclusions List Section -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Folder Exclusions" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6" />

                <Border Grid.Row="1" Background="{DynamicResource SecondarySurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderGlassEdgeBrush}" BorderThickness="1">
                    <ListBox x:Name="ExclusionsListBox" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Segoe UI" FontSize="11.5" Margin="6" />
                </Border>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NewExclusionTextBox" Grid.Column="0" Height="28" Background="{DynamicResource SecondarySurfaceBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderGlassEdgeBrush}" BorderThickness="1"
                             Padding="8,3" Margin="0,0,8,0" VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Button Grid.Column="1" Content="Add" Click="AddExclusionButton_Click" Background="{DynamicResource AccentBrush}"
                            Foreground="White" BorderThickness="0" Padding="14,4" Margin="0,0,6,0" Cursor="Hand" FontFamily="Segoe UI" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Column="2" Content="Remove" Click="RemoveExclusionButton_Click" Background="{DynamicResource SecondarySurfaceBrush}"
                            Foreground="{DynamicResource SecondaryTextBrush}" BorderBrush="{DynamicResource BorderGlassEdgeBrush}" BorderThickness="1"
                            Padding="12,4" Cursor="Hand" FontFamily="Segoe UI">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>

            <!-- Bottom Actions -->
            <Button Grid.Row="3" Content="Done" Click="DoneButton_Click" HorizontalAlignment="Right"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="22,6"
                    FontFamily="Segoe UI" FontWeight="SemiBold" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
