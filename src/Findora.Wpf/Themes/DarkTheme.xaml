<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- FINDORA LIQUID GLASS DESIGN SYSTEM - DARK THEME (SMOKY OBSIDIAN)  -->
    <!-- Apple-Inspired Optical Refraction, Specular Bevels & Depth        -->
    <!-- ================================================================= -->

    <!-- 1. Pure Transmission Glass Base (High transmission allows live desktop refraction) -->
    <LinearGradientBrush x:Key="LiquidGlassTransmissionBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#36081220" Offset="0.0" />
        <GradientStop Color="#28050C16" Offset="0.6" />
        <GradientStop Color="#20030810" Offset="1.0" />
    </LinearGradientBrush>
    
    <!-- Backward compatibility alias -->
    <LinearGradientBrush x:Key="WindowGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#36081220" Offset="0.0" />
        <GradientStop Color="#28050C16" Offset="0.6" />
        <GradientStop Color="#20030810" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassWindowGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#36081220" Offset="0.0" />
        <GradientStop Color="#28050C16" Offset="0.6" />
        <GradientStop Color="#20030810" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 2. Outer Bevel & Caustic Refraction Rim (Physical glass curve catching ambient light) -->
    <LinearGradientBrush x:Key="LiquidGlassBevelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55FFFFFF" Offset="0.0" />
        <GradientStop Color="#2438BDF8" Offset="0.25" />
        <GradientStop Color="#101E293B" Offset="0.75" />
        <GradientStop Color="#2038BDF8" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WindowBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55FFFFFF" Offset="0.0" />
        <GradientStop Color="#2438BDF8" Offset="0.25" />
        <GradientStop Color="#101E293B" Offset="0.75" />
        <GradientStop Color="#2038BDF8" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassRimBorderGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55FFFFFF" Offset="0.0" />
        <GradientStop Color="#2438BDF8" Offset="0.25" />
        <GradientStop Color="#101E293B" Offset="0.75" />
        <GradientStop Color="#2038BDF8" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 3. Internal Sub-Surface Thickness Bevel (Simulates 4mm physical glass volume) -->
    <LinearGradientBrush x:Key="LiquidGlassInnerBevelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#22FFFFFF" Offset="0.0" />
        <GradientStop Color="#0838BDF8" Offset="0.3" />
        <GradientStop Color="#00000000" Offset="0.7" />
        <GradientStop Color="#1238BDF8" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 4. Top-Edge Specular Fresnel Highlight -->
    <LinearGradientBrush x:Key="TopReflectionBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0.0" />
        <GradientStop Color="#40FFFFFF" Offset="0.2" />
        <GradientStop Color="#70FFFFFF" Offset="0.5" />
        <GradientStop Color="#40FFFFFF" Offset="0.8" />
        <GradientStop Color="#00FFFFFF" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TopReflectionGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0.0" />
        <GradientStop Color="#40FFFFFF" Offset="0.2" />
        <GradientStop Color="#70FFFFFF" Offset="0.5" />
        <GradientStop Color="#40FFFFFF" Offset="0.8" />
        <GradientStop Color="#00FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 5. Bottom Caustic Rebound Glint (Optical focus through glass bottom) -->
    <LinearGradientBrush x:Key="BottomCausticBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00000000" Offset="0.0" />
        <GradientStop Color="#1838BDF8" Offset="0.25" />
        <GradientStop Color="#3038BDF8" Offset="0.5" />
        <GradientStop Color="#1838BDF8" Offset="0.75" />
        <GradientStop Color="#00000000" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 6. Search Surface & Dynamic Focus Lens -->
    <SolidColorBrush x:Key="SearchSurfaceBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="SearchBorderBrush" Color="#2238BDF8" />
    <SolidColorBrush x:Key="SearchFocusBorderBrush" Color="#6038BDF8" />

    <!-- 7. Sub-surfaces & Separator Lines -->
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="#14070E1A" />
    <SolidColorBrush x:Key="GlassEdgeBrush" Color="#1294A3B8" />
    <SolidColorBrush x:Key="BorderGlassEdgeBrush" Color="#1838BDF8" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#1294A3B8" />

    <!-- 8. Typography (Crisp 100% Opaque Foreground) -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

    <!-- 9. Liquid Accents -->
    <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="CyanAccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="PerfAccentBrush" Color="#2DD4BF" />
    <SolidColorBrush x:Key="MintGreenBrush" Color="#2DD4BF" />
    <SolidColorBrush x:Key="MintGreenBrightBrush" Color="#34D399" />

    <!-- 10. Interactive Liquid Lens Rows (Hover & Selected States) -->
    <SolidColorBrush x:Key="HoverBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#2238BDF8" />
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#4038BDF8" />
    <LinearGradientBrush x:Key="SelectionPillGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2C38BDF8" Offset="0.0" />
        <GradientStop Color="#141D4ED8" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 11. Keycap Badges -->
    <SolidColorBrush x:Key="KeycapBackgroundBrush" Color="#1E0E1B2E" />
    <SolidColorBrush x:Key="KeycapBorderBrush" Color="#2E38BDF8" />
    <SolidColorBrush x:Key="KeycapTextBrush" Color="#7DD3FC" />

    <Style x:Key="KeycapBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KeycapBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KeycapBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 12. Minimal Translucent ScrollBar -->
    <Style x:Key="GlassScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border CornerRadius="3" Background="#2538BDF8" Margin="2,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" Value="#5038BDF8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Width" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource GlassScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 13. Translucent Glass ContextMenu -->
    <Style x:Key="DarkGlassContextMenu" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#D00B1626" BorderBrush="#3038BDF8" BorderThickness="1.2"
                            CornerRadius="12" Padding="6,8" Width="250">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.6" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassMenuItemStyle" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="MenuBorder" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="2,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Icon" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Icon" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="MenuBorder" Property="Background" Value="#2538BDF8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="#1294A3B8" Margin="8,4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
